# .gitignore

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Env (não versionar segredos)
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
*.env

# Build output (raiz e gen)
build/
build-mock-test/
dist/
gen/dist/
output/

# Entidades geradas (dentro de outputDir quando diferente de build/)
entities/

# Node
node_modules/
jspm_packages/
.npm
.yarn-integrity
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Test: DBs e artefatos gerados
test/e2e-generator/mock.sqlite
test/e2e-generator/projects/todo/db/database.db
test/e2e-generator/projects/todo/db/*.db
db/*.db

# Validação curl (renderização capturada)
render.html

# TypeScript
*.tsbuildinfo

# Coverage e instrumentação
coverage
*.lcov
.nyc_output
lib-cov

# Cache e temporários
.cache
.parcel-cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.grunt
.fusebox/
.serverless/
.dynamodb/

# Runtime / diagnóstico
pids
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
.node_repl_history

# Lint / format cache
.eslintcache
.stylelintcache

# Empacotamento
*.tgz

# Frameworks (referência; projeto usa Nest no output)
.next
out
.nuxt
.vuepress/dist
.docusaurus
.vscode-test

# Build nativo
build/Release
.lock-wscript
web_modules/
.tern-port
