// src/api/client.ts
// Auto-generated API client for <%= pascalName %> paging endpoint

export interface PagingRequest {
  page?: number;
  pageSize?: number;
  sort?: string;
  order?: 'ASC' | 'DESC';
  filters?: Record<string, any>;
}

export interface PagingResponse<T> {
  data: T[];
  total: number;
  page: number;
  pageSize: number;
  totalPages: number;
}
<% typedColumns.forEach((col) => { %>

export interface <%= col.interfaceName %> {
  <%= col.columnName %>: <%= col.typescriptType %>;
}
<% }) %>

export interface <%= pascalName %>Record {
  id: <%= idType %>;
  <%- columnsWithIndent %>
}

const API_BASE = '<%= endpointPaging %>';

export const <%= camelName %>PagingApi = {
  async getPage(request: PagingRequest): Promise<PagingResponse<<%= pascalName %>Record>> {
    const params = new URLSearchParams();

    if (request.page) params.append('page', String(request.page));
    if (request.pageSize) params.append('pageSize', String(request.pageSize));
    if (request.sort) params.append('sort', request.sort);
    if (request.order) params.append('order', request.order);

    if (request.filters) {
      Object.entries(request.filters).forEach(([key, value]) => {
        if (value !== undefined && value !== null && value !== '') {
          params.append(`filter[${key}]`, String(value));
        }
      });
    }

    const response = await fetch(`${API_BASE}?${params.toString()}`, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
      },
    });

    if (!response.ok) {
      throw new Error(`Failed to fetch <%= pascalName %> data: ${response.statusText}`);
    }

    return response.json();
  },
};
