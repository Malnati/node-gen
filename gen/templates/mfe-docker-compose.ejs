services:
  api:
    build:
      context: ..
      dockerfile: Dockerfile
    ports:
      - "${API_PORT:-3000}:${API_PORT:-3000}"
    environment:
      - PORT=${API_PORT:-3000}
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:${API_PORT:-3000}/health || exit 1"]
      interval: 5s
      timeout: 5s
      retries: 10

  app-shell:
    build:
      context: ./app-shell
    ports:
      - "${APP_SHELL_PORT:-9000}:${APP_SHELL_PORT:-9000}"
    depends_on:
<% mfeList.forEach(function(mfe) { %>
      <%= mfe.kebabName %>-mfe:
        condition: service_started
<% }); %>

<% mfeList.forEach(function(mfe) { %>
  <%= mfe.kebabName %>-mfe:
    build:
      context: ./<%= mfe.kebabName %>-mfe
    ports:
      - "<%= mfe.port %>:<%= mfe.port %>"
    environment:
      - VITE_API_URL=http://api:${API_PORT:-3000}

<% }); %>
