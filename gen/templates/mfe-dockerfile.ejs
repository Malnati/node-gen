FROM node:18-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=build /app/dist /usr/share/nginx/html/mfes/<%= kebabName %>-mfe
RUN printf 'server {\n  listen <%= port %>;\n  location / {\n    root /usr/share/nginx/html;\n    try_files $uri $uri/ /index.html;\n    add_header Access-Control-Allow-Origin *;\n  }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE <%= port %>
CMD ["nginx", "-g", "daemon off;"]
