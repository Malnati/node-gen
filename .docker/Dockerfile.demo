# .docker/Dockerfile.demo
FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_DISCOVERY_BASE_URL=http://localhost:3015
ENV VITE_DISCOVERY_BASE_URL=${VITE_DISCOVERY_BASE_URL}

COPY demo/sspa/package*.json ./
RUN if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi

COPY demo/sspa/ ./
RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY .docker/sspa/demo-dynamic.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
