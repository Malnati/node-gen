# .docker/Dockerfile.e2e
FROM node:20-bookworm

ENV TZ=America/Sao_Paulo
RUN ln -fs /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        python3 \
        libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

RUN cd gen && npm install --legacy-peer-deps && npm run build

ENV NODE_PATH=/app/gen/node_modules
ENV E2E_DB_TYPES=sqlite
RUN node test/e2e-generator/db.js

ENTRYPOINT ["/app/.docker/entrypoint.e2e.sh"]
