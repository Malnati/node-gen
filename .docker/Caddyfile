# .docker/Caddyfile.template
{
    email admin@{$PUBLIC_DOMAIN}
}

(cors) {
    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
        Access-Control-Allow-Headers "*"
    }
}

# SSPA Orchestrator
sspa.{$PUBLIC_DOMAIN} {
    import cors
    reverse_proxy nodegen-sspa:80
}

# Service Discovery
discovery.{$PUBLIC_DOMAIN} {
    import cors
    reverse_proxy nodegen-service-discovery:3015
}

# API Entry Point (Global)
api.{$PUBLIC_DOMAIN} {
    import cors

    handle_path /accounts/* { reverse_proxy nodegen-apis:3001 }
    handle_path /addresses/* { reverse_proxy nodegen-apis:3002 }
    handle_path /auth/* { reverse_proxy nodegen-apis:3003 }
    handle_path /communications/* { reverse_proxy nodegen-apis:3004 }
    handle_path /config/* { reverse_proxy nodegen-apis:3005 }
    handle_path /consents/* { reverse_proxy nodegen-apis:3006 }
    handle_path /contacts/* { reverse_proxy nodegen-apis:3007 }
    handle_path /gmail/* { reverse_proxy nodegen-apis:3008 }
    handle_path /google-calendar/* { reverse_proxy nodegen-apis:3009 }
    handle_path /google-drive/* { reverse_proxy nodegen-apis:3010 }
    handle_path /llm/* { reverse_proxy nodegen-apis:3011 }
    handle_path /logistics/* { reverse_proxy nodegen-apis:3012 }
    handle_path /maps/* { reverse_proxy nodegen-apis:3013 }
    handle_path /notifications/* { reverse_proxy nodegen-apis:3014 }
    handle_path /orders/* { reverse_proxy nodegen-apis:3015 }
    handle_path /payments/* { reverse_proxy nodegen-apis:3016 }
    handle_path /products/* { reverse_proxy nodegen-apis:3017 }
    handle_path /reports/* { reverse_proxy nodegen-apis:3018 }
    handle_path /roles/* { reverse_proxy nodegen-apis:3019 }
    handle_path /schedule/* { reverse_proxy nodegen-apis:3020 }
    handle_path /selling/* { reverse_proxy nodegen-apis:3021 }
    handle_path /tenant/* { reverse_proxy nodegen-apis:3022 }
    handle_path /todo/* { reverse_proxy nodegen-apis:3023 }
    handle_path /transactions/* { reverse_proxy nodegen-apis:3024 }
    handle_path /users/* { reverse_proxy nodegen-apis:3025 }
    handle_path /warehouse/* { reverse_proxy nodegen-apis:3026 }    # Fallback to first API
    reverse_proxy nodegen-apis:3001
}

# Standalone MFEs (Dynamic Subdomains)

