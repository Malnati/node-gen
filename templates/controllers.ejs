import { Controller, Get, Post, Put, Delete, Body, Param, NotFoundException, BadRequestException, InternalServerErrorException, UseGuards } from '@nestjs/common';
import { ApiTags, ApiOperation, ApiResponse } from '@nestjs/swagger';
import { <%= table.entityName %>Service } from './<%= table.tableName %>.service';
import { <%= table.entityName %>QueryDTO, <%= table.entityName %>PersistDTO } from './<%= table.tableName %>.dto';
import { JwtAuthGuard } from '../middleware/jwt-auth.guard';

@ApiTags('<%= table.tableName %>')
@Controller('<%= table.tableName %>')
export class <%= table.entityName %>Controller {
  constructor(private readonly <%= table.entityName.toLowerCase() %>Service: <%= table.entityName %>Service) {}

  @Post()
  @UseGuards(JwtAuthGuard)
  @ApiOperation({
    summary: "Criação de um novo <%= table.entityName %>.",
    description: "Este endpoint cria um novo <%= table.entityName %> no sistema com as informações fornecidas.",
  })
  @ApiResponse({
    status: 201,
    description: 'O <%= table.entityName %> foi criado com sucesso.',
    type: <%= table.entityName %>QueryDTO,
  })
  @ApiResponse({ status: 400, description: 'Dados inválidos' })
  @ApiResponse({ status: 409, description: '<%= table.entityName %> já existe' })
  @ApiResponse({ status: 500, description: 'Erro interno no servidor' })
  async create(@Body() dto: <%= table.entityName %>PersistDTO): Promise<<%= table.entityName %>QueryDTO> {
    try {
      return await this.<%= table.entityName.toLowerCase() %>Service.create(dto);
    } catch (error) {
      if (error.code === '23505') {
        throw new BadRequestException('<%= table.entityName %> já existe');
      }
      throw new InternalServerErrorException('Erro ao criar <%= table.entityName %>');
    }
  }

  @Get(':external_id')
  @UseGuards(JwtAuthGuard)
  @ApiOperation({
    summary: "Busca um <%= table.entityName %> pelo External ID.",
    description: "Este endpoint busca um <%= table.entityName %> no sistema pelo External ID fornecido.",
  })
  @ApiResponse({
    status: 200,
    description: 'O <%= table.entityName %> foi encontrado.',
    type: <%= table.entityName %>QueryDTO,
  })
  @ApiResponse({ status: 404, description: '<%= table.entityName %> não encontrado' })
  async findByExternalId(@Param('external_id') external_id: string): Promise<<%= table.entityName %>QueryDTO> {
    try {
      return await this.<%= table.entityName.toLowerCase() %>Service.findByExternalId(external_id);
    } catch (error) {
      throw new NotFoundException('<%= table.entityName %> não encontrado');
    }
  }

  @Get()
  @UseGuards(JwtAuthGuard)
  @ApiOperation({
    summary: "Busca todos os <%= table.entityName %>s.",
    description: "Este endpoint busca todos os <%= table.entityName %>s cadastrados no sistema.",
  })
  @ApiResponse({
    status: 200,
    description: 'Lista de <%= table.entityName %>s.',
    type: [<%= table.entityName %>QueryDTO],
  })
  async findAll(): Promise<<%= table.entityName %>QueryDTO[]> {
    return await this.<%= table.entityName.toLowerCase() %>Service.findAll();
  }

  @Put(':external_id')
  @UseGuards(JwtAuthGuard)
  @ApiOperation({
    summary: "Atualiza um <%= table.entityName %> pelo External ID.",
    description: "Este endpoint atualiza os detalhes de um <%= table.entityName %> no sistema pelo External ID fornecido.",
  })
  @ApiResponse({
    status: 200,
    description: 'O <%= table.entityName %> foi atualizado com sucesso.',
    type: <%= table.entityName %>QueryDTO,
  })
  @ApiResponse({ status: 400, description: 'Dados inválidos' })
  @ApiResponse({ status: 404, description: '<%= table.entityName %> não encontrado' })
  @ApiResponse({ status: 500, description: 'Erro interno no servidor' })
  async updateByExternalId(@Param('external_id') external_id: string, @Body() dto: <%= table.entityName %>PersistDTO): Promise<<%= table.entityName %>QueryDTO> {
    try {
      return await this.<%= table.entityName.toLowerCase() %>Service.updateByExternalId(external_id, dto);
    } catch (error) {
      if (error instanceof NotFoundException) {
        throw new NotFoundException('<%= table.entityName %> não encontrado');
      }
      throw new InternalServerErrorException('Erro ao atualizar <%= table.entityName %>');
    }
  }

  @Delete(':external_id')
  @UseGuards(JwtAuthGuard)
  @ApiOperation({
    summary: "Deleta um <%= table.entityName %> pelo External ID.",
    description: "Este endpoint deleta um <%= table.entityName %> no sistema pelo External ID fornecido.",
  })
  @ApiResponse({
    status: 204,
    description: 'O <%= table.entityName %> foi deletado com sucesso.',
  })
  @ApiResponse({ status: 404, description: '<%= table.entityName %> não encontrado' })
  @ApiResponse({ status: 500, description: 'Erro interno no servidor' })
  async deleteByExternalId(@Param('external_id') external_id: string): Promise<void> {
    try {
      await this.<%= table.entityName.toLowerCase() %>Service.deleteByExternalId(external_id);
    } catch (error) {
      if (error instanceof NotFoundException) {
        throw new NotFoundException('<%= table.entityName %> não encontrado');
      }
      throw new InternalServerErrorException('Erro ao deletar <%= table.entityName %>');
    }
  }
}
